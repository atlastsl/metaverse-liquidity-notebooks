#| label: fig-land-sales-volume-ts
#| layout-nrow: 1
#| fig-cap: "Volumes de ventes hebdomadaires de parcelles Decentraland dans le temps"
#| warning: false
library(dplyr)
library(tidyr)
library(lubridate)
Transactions |>
filter(type == "transfer", asset_contract == LandContract, is_sale = T, !is.na(amount_usd)) |>
select(date, amount_usd) |>
mutate(week = lubridate::floor_date(date, unit = "week", week_start = 1)) |>
summarise(
vol = sum(amount_usd, na.rm=T),
.by = c("week")
) |>
ggplot(aes(x = week)) +
geom_line(aes(y = vol), color = "navyblue", linewidth = 1) +
labs(
x = "Time (in years)",
y = "Volume ($ USD)"
) +
theme_minimal()
