#| tbl-cap: "Médiation de l'Attention dans les effets Localisation - Liquidité\nMéthode de Baron & Kenny\nLa liquidité est mesurée par le time-on-market, et l'attention par la demande normalisée en période de listing"
#| warning: false
#| echo: false
library(lubridate)
library(dplyr)
library(tidyr)
library(modelsummary)
library(broom)
library(gt)
source("./models.R")
alq_db <- readRDS(file = "alq_db_2019_2020.RDS")
Ys <- list("Sold", "Sold", "Sold", "DPC", "DPX", "DRD", "DDX")
# Xs <- list(
#   c("DPC", "DPX", "DRD", "DDX", "Lvalue"),
#   c("Attention", "Lvalue"),
#   c("Attention", "DPC", "DPX", "DRD", "DDX", "Lvalue"),
#   c("Soldf", "Attention", "Lvalue"),
#   c("Soldf", "Attention", "Lvalue"),
#   c("Soldf", "Attention", "Lvalue"),
#   c("Soldf", "Attention", "Lvalue")
# )
Xs <- list(
c("DPC", "DPX", "DRD", "DDX"),
c("Attention"),
c("Attention", "DPC", "DPX", "DRD", "DDX"),
c("Soldf", "Attention"),
c("Soldf", "Attention"),
c("Soldf", "Attention"),
c("Soldf", "Attention")
)
db <- alq_db |>
mutate(quarter = quarter(date), year = year(date)) |>
#filter(quarter == 3, year == 2020) |>
filter(status == "filled" | status == "expired") |>
mutate(
Lvalue = log1p(value),
Sold = as.numeric(status == "filled"),
Attention = factor(as.numeric(asks_ul_30d > 0), levels = c(0, 1), labels=c("No", "Yes")),
Soldf = factor(Sold, levels = c(0, 1), labels=c("No", "Yes")),
AttNorm = asks_ul_m30d
) |>
filter(if_all(c("Lvalue"), ~ filter_outliers(.x)))
results <- vector(mode = "list", length = length(Ys))
for (i in seq_along(Ys)) {
if (i >= 4) {
res = lm_model(
db,
Y = Ys[[i]],
X = Xs[[i]]
)
results[[i]] = res$model
} else {
res = logit_model(
db,
Y = Ys[[i]],
X = Xs[[i]]
)
results[[i]] = res
}
}
modelsummary(results, stars = TRUE, statistic = "p.value", output = "gt") |>
tab_options(table.font.size = px(16))
