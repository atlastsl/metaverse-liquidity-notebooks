quantile(boot_results_2[2, ], probs = c(0.025, 0.975))
quantile(boot_results_2[3, ], probs = c(0.025, 0.975))
i <- 0
boot_results_2 <- replicate(499, {
idx <- sample(seq_len(nrow(dat)), replace = TRUE)
r = med_anl_once_func(
