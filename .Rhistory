#| label: tbl-res4-esbt-bk-a
#| tbl-cap: "[Parcelles] Régressions de Baron & Kenny en régime normal<br>L'attention est mesurée par les offres d'achat et est transformée en variable binaire"
#| warning: false
#| echo: false
baron_kenny_summ(
c("Normal"),
asset_type = "estate",
att_type = "3f",
att_mode = "base"
)
baron_kenny_model <- function (index, db, reg, asset_type, att_type) {
if (index == 1 || index == 3) {
att_type_ = NULL
if (index == 3) {
att_type_ = att_type
}
fit = liq_model_func(
db,
reg,
att_type = att_type_,
asset_type = asset_type,
model_type = "aft"
)
td = get_estimates(fit, ci_method = "wald") |>
filter(!str_detect(term, "^Q\\d+_\\d+"))
gf = get_gof(fit)
gf[["qt.fe"]] = "Yes"
gf[["r2"]] = gf[["r2.nagelkerke"]]
mod = list(tidy = td, glance = gf)
class(mod) <- "modelsummary_list"
return(mod)
}
else if (index == 2) {
fit = att_model_func(
db,
reg,
att_type = att_type,
asset_type = asset_type
)
td = get_estimates(fit, ci_method = "wald") |>
filter(!str_detect(term, "^Q\\d+_\\d+"))
gf = get_gof(fit)
gf[["qt.fe"]] = "Yes"
gf[["mcfadden"]] = PseudoR2(fit)
gf[["r2"]] = gf[["mcfadden"]]
mod = list(tidy = td, glance = gf)
class(mod) <- "modelsummary_list"
return(mod)
}
return(NULL)
}
baron_kenny_summ <- function (regimes, asset_type = "land", att_type = "bin", att_mode = "base") {
db <- liq_db_refiner(asset_type, att_mode)
my_gof <- list(
list("raw" = "qt.fe",     "clean" = "Quarters FE", fmt = 0),
list("raw" = "nobs",     "clean" = "Num.Obs.",    "fmt" = 0),
#list("raw" = "mcfadden", "clean" = "R2 McFadden", "fmt" = 3),
#list("raw" = "r2.nagelkerke", "clean" = "R2 Nagel", "fmt" = 3),
#list("raw" = "r.squared", "clean" = "R2", "fmt" = 3),
#list("raw" = "r.squared.adj", "clean" = "R2 Adj", "fmt" = 3),
#list("raw" = "logLik",   "clean" = "Log Lik.",    "fmt" = 2),
#list("raw" = "rmse",     "clean" = "RMSE",        "fmt" = 2),
list("raw" = "r2", "clean" = "R2 (Nagel|McFadden)", "fmt" = 3),
list("raw" = "aic",      "clean" = "AIC",         "fmt" = 1),
list("raw" = "bic",      "clean" = "BIC",         "fmt" = 1)
)
results <- vector(mode = "list", length = 3*length(regimes))
i <- 1
for (k in seq_along(regimes)) {
for (index in 1:3) {
modi = baron_kenny_model(
index = index,
db = db,
reg = regimes[k],
asset_type = asset_type,
att_type = att_type
)
results[[i]] = modi
i <- i+1
}
}
names(results) <- rep(
c("Reg 1<br>Liq", "Reg 2<br>Att", "Reg 3<br>Liq"),
length(regimes)
)
glist <- vector(mode = "list", length = length(regimes))
for (k in seq_along(regimes)) {
glist[[k]] = (3*k-1):(3*k+1)
}
names(glist) <- paste0("Regime ", regimes)
tab <- modelsummary(
results,
gof_map = my_gof,
stars = TRUE,
statistic = "p.value",
output = "tinytable"
) |> style_tt(fontsize = 0.8) |> group_tt(j = glist)
colnames(tab) <- c(" ", colnames(tab)[-1])
tab
}
