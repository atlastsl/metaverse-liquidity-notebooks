LogSize = log(size),
)
}
dat = dat |>
mutate(
year = year(date),
quarter = paste0("Q", quarter(date), "_", year)
) |>
mutate(qname = quarter) |>
mutate(v = 1) |>
pivot_wider(names_from = qname, values_from = v, values_fill = 0)
boot_results <- NULL
B <- boot_N
if (boot_mode == "seq") {
set.seed(117)
i <- 0
boot_results <- replicate(B, {
idx <- sample(seq_len(nrow(dat)), replace = TRUE)
r = med_anl_once_func(
boot_idx = idx,
dat,
asset_type = asset_type,
att_type = att_type,
att_mode = att_mode,
u_eval_func = u_eval_func,
predict_mode = "exp",
liq_params = list(horizon=30, measure=liq_measure)
)
i <<- i + 1
cat("Running bootstrap replicate:", i, "of", B, "\r")
r
})
} else {
plan(multisession, workers = min(4L, parallelly::availableCores(omit = 1)))
handlers("txtprogressbar")
set.seed(117)
boot_results <- with_progress(
{
p <- progressor(steps = B)
future_replicate(
B,
{
idx <- sample(seq_len(nrow(dat)), replace = TRUE)
r = med_anl_once_func(
boot_idx = idx,
dat,
asset_type = asset_type,
att_type = att_type,
att_mode = att_mode,
u_eval_func = u_eval_func,
predict_mode = "exp",
liq_params = list(horizon=30, measure=liq_measure)
)
p()  # Report one completed replicate
r
},
future.seed = TRUE
)
},
enable = TRUE
)
plan(sequential)
}
ci <- as.data.frame(do.call(rbind, lapply(seq_len(nrow(boot_results)), function(i){
quantile(boot_results[i, ], c(0.025, 0.975))
})))
rownames(ci) <- rownames(boot_results)
return(ci)
}
