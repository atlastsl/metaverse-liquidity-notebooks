att_high_split = 5
if (att_mode == "distinct") {
att_suffix = "askers"
att_high_split = 5
} else if (att_mode == "extended") {
att_suffix = "askers_ext"
att_high_split = 5
}
att_base_var <- paste0("att_", att_suffix)
db <- NULL
if (asset_type == "land") {
artdatalst = readRDS(file = "artdata/artdatalst.RDS")
db <- artdatalst$listings #|> filter(!is.na(regime), nfilled_li_30d == 0) |>
} else if (asset_type == "estate") {
artdatalst = readRDS(file = "artdata/artdataelst.RDS")
db <- artdatalst$listings |>
filter(DPC >= 0 & size > 0)
}
if (!is.null(db)) {
db <- db |>
filter(!is.na(regime)) |>
#filter(nfilled_li_30d == 0) |>
mutate(
att_asks = asks_ll_30d,
att_askers = lengths(
pmap(
list(askers_ll_30d_add, maker),
\(x, y) setdiff(x, y)
)
),
att_askers_ext = lengths(
pmap(
list(askers_ext_ll_30d_add, maker),
\(x, y) setdiff(x, y)
)
),
only_asked_by_seller = as.numeric(askers_ll_30d == 1 & att_askers == 0),
# att_askers = askers_ll_30d,
# att_askers_buyers = lengths(
#   pmap(
#     # list(nfilled_li_30d_tkrs, askers_ll_30d_add, nfilled_li_30d_mkrs, maker),
#     # \(x, y, ex1, ex2) setdiff(setdiff(union(x, y), ex1), ex2)
#     list(nfilled_li_30d_tkrs, askers_ll_30d_add, nfilled_li_30d_mkrs, maker),
#     \(x, y, ex1, ex2) union(setdiff(setdiff(x, ex1), ex2), y)
#   )
# ),
#att_plus = asks_ll_30d + nfilled_li_30d,
#att_plus = lengths(pmap(
#  list(nfilled_li_30d_tkrs, askers_ll_30d_add, maker),
#  \(x, y, ex) setdiff(union(x, y), ex)
#)),
#own_changed = nfilled_li_30d, #factor(if_else(nfilled_li_30d > 0, "Y", "N"), levels = c("N", "Y")),
attention = .data[[att_base_var]],
att_chr = if_else(
attention == 0,
"Z",
if_else(attention <= att_high_split, "L", "H")
),
att_3of = factor(att_chr, levels = c("Z", "L", "H"), ordered = T),
att_3uf = factor(att_chr, levels = c("Z", "L", "H"), ordered = F),
att_bin = as.numeric(attention > 0),
att_bnf = factor(if_else(attention > 0, "Y", "N"), levels = c("N", "Y")),
mkt_expo_time = ndays_li_30d/30,
mkt_exposed = factor(if_else(ndays_li_30d > 0, "Y", "N"), levels = c("N", "Y")),
DPC_close = factor(if_else(DPC <= log1p(center_closeness), "Y", "N"), levels = c("N", "Y")),
#DPC_close =
) |>
filter(only_asked_by_seller == 0) |>
arrange(date)
}
return(db)
}
