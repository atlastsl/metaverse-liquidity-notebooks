quantile(DPCt, c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(DPCt),
sd(DPCt)
),
loc_sales = c(
quantile(DPCt[which(status == "filled")], c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(DPCt[which(status == "filled")]),
sd(DPCt[which(status == "filled")])
),
price_all = c(
quantile(mprice, c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(mprice),
sd(mprice)
),
price_sales = c(
quantile(mprice[which(status == "filled")], c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(mprice[which(status == "filled")]),
sd(mprice[which(status == "filled")])
),
att_all = c(
quantile(asks_ll_30d, c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(asks_ll_30d),
sd(asks_ll_30d)
),
att_sales = c(
quantile(asks_ll_30d[which(status == "filled")], c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(asks_ll_30d[which(status == "filled")]),
sd(asks_ll_30d[which(status == "filled")])
),
expo_all = c(
quantile(exposure, c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(exposure),
sd(exposure)
),
expo_sales = c(
quantile(exposure[which(status == "filled")], c(0.01, 0.1, 0.5, 0.9, 0.99)),
mean(exposure[which(status == "filled")]),
sd(exposure[which(status == "filled")])
),
#att_vol = c(quantile(att_vol, c(0.01, 0.1, 0.5, 0.9, 0.99))/1000, mean(att_vol)/1000, sd(att_vol)/1000),
#att_gt = c(quantile(att_gt, c(0.01, 0.1, 0.5, 0.9, 0.99)), mean(att_gt), sd(att_gt)),
.by = "regime"
) |>
mutate(
tom_all = round(tom_all, digits = 3),
tom_sales = round(tom_sales, digits = 3),
price_all = round(price_all, digits = 3),
price_sales = round(price_sales, digits = 3),
expo_all = round(expo_all*100, digits = 3),
expo_sales = round(expo_sales*100, digits = 3),
) |>
select(-regime)
#colnames(smr) <- c("Stat.", "All listings", "Converted into sales", "# Listings", "# Sales", "% Sales", "All listings", "Converted into sales", "30 prev. days sales vol (10<sup>3</sup>USD)", "Google Trends Index")
colnames(smr) <- c(
"Stat.",
"All listings",
"Converted into sales",
"% Sales",
"All listings",
"Converted into sales",
"All listings",
"Converted into sales",
"All listings",
"Converted into sales",
"All listings",
"Converted into sales"
)
p = tt(
smr,
digits = 3,
notes = "Les échelles des indices Google Trends diffèrent suivant les régimes, et les volumes de ventes sont en milliers de dollars.",
replace = "-",
width = rep(1/12, 12)
) |>
style_tt(fontsize = 0.9) |>
format_tt(replace = "-") |>
group_tt(
j = list(
"Time on market (days)" = 2:3,
"% Sales" = 4:4,
"Distance to Central Plaza (# parcels)" = 5:6,
"Listing price (10^3 US$)" = 7:8,
"Attention (# bids)" = 9:10,
"Past exposure (% on 30d)" = 11:12
)
) |>
group_tt(
i = list(
"Normal Regime (2019-2020)" = 1,
"Expansion/Boom Regime (2021)" = 8,
"Recession/Crash Regime (2022)" = 15,
"Low recession/Desert Regime (2023-2024)" = 22
)
) |>
format_tt(j = 2:3, digits = 3) |>
format_tt(j = 7:8, digits = 3) |>
format_tt(j = 9:10, digits = 3) |>
format_tt(j = 11:12, digits = 3) |>
style_tt(i = 8, line = "b", line_width = 0.1) |>
style_tt(i = 16, line = "b", line_width = 0.1) |>
style_tt(i = 24, line = "b", line_width = 0.1)
p
