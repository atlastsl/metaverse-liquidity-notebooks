eventvar   = "event",
avar       = "DPC",
mvar       = "att_dmn",
cvar       = c("CRD", "CPX", "CDX", "North",
"LogPrice", "listed",
"mvalue_li_30d", "nndays_li_30d",
"Q3_2019", "Q4_2019", "Q1_2020",
"Q2_2020", "Q3_2020", "Q4_2020"),
mreg       = "logistic",
yreg       = "survAFT_weibull",  # or "survCox"
# a-path moderation: DPC x U in mediator model
emm_ac_mreg = "nndays_li_30d",
# b-path moderation: Y x U in outcome model
emm_mc_yreg = "nndays_li_30d",
# Conditional effects: specify covariate values,
# including the U level at which effects are evaluated
c_cond = c(
CRD = 1, CPX = 1, CDX = 1, North = 1,
LogPrice = median(dat$LogPrice),
listed = 1,
Q3_2019 = 0, Q4_2019 = 0, Q1_2020 = 0,
Q2_2020 = 0, Q3_2020 = 0, Q4_2020 = 1,
mvalue_li_30d = median(dat$mvalue_li_30d),
nndays_li_30d = median(dat$nndays_li_30d)
),
a0 = mean(dat$DPC),
a1 = mean(dat$DPC) + sd(dat$DPC)
)
