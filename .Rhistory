plot(x, y=0.7-0.6*x, xaxt="n", yaxt='s', type="l", ylim=c(0,1), xlab="Localisation", ylab="Liquidity", main="Régime normal")
plot(x, y=0.8-0.5*x, xaxt="n", yaxt='s', type="l", ylim=c(0,1), xlab="Localisation", ylab="Liquidity", main="Régime d'attention globale forte")
plot(x, y=1-0.3*x, xaxt="n", yaxt='s', type="l", ylim=c(0,1), xlab="Localisation", ylab="Liquidity", main="Régime spéculatif")
#| label: fig-h6-rlw
