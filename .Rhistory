#| warning: false
#| echo: false
library(lubridate)
library(dplyr)
library(tidyr)
library(modelsummary)
library(broom)
library(tinytable)
library(DescTools)
library(ggplot2)
#######################################
## Regressions
#######################################
source("./models.R")
alq_db_R1 <- readRDS(file = "alq_db_2019_2020_v2.RDS")
alq_db_R2 <- readRDS(file = "alq_db_2021.RDS")
alq_db_R3 <- readRDS(file = "alq_db_2022.RDS")
alq_db_R4 <- readRDS(file = "alq_db_2023_2024.RDS")
db_list_idx <- 1:4
qt_list <- list(
list(ys=2019:2020, qs=1:4),
list(ys=2021, qs=1:4),
list(ys=2022, qs=1:4),
list(ys=2023:2024, qs=1:4)
)
Xcols <- c("DPC", "CPX", "CRD", "CDX", "North", "LogPrice")
tab1 <- list()
tab2 <- list()
qdates <- c()
k <- 1
for (k in db_list_idx) {
db <- NULL
eval(parse(text = paste0("db <- alq_db_R", k)))
db <- db |>
filter(!is.na(tom) & tom > 0) |>
mutate(
sold = as.numeric(status == "filled" & tom <= 365),
tom = if_else(tom > 365, 365, tom),
LogPrice = log(Winsorize(value, val = quantile(value, probs = c(0.01, 0.99))))
) |>
mutate(quarter = quarter(date), year = year(date))
ys <- qt_list[[k]]$ys
qs <- qt_list[[k]]$qs
for (y in ys) {
for (q in qs) {
db_elm <- db |> filter(quarter == q, year == y)
fit1 = aft_model(
db_elm,
Y_time = "tom",
Y_event = "sold",
X = Xcols,
error_cluster = "asset_id"
)
td1 = get_estimates(fit1)
fit2 = cox_model(
db_elm,
Y_time = "tom",
Y_event = "sold",
X = Xcols,
error_cluster = "asset_id"
)
td2 = get_estimates(fit2)
qdate = floor_date(make_date(y, (q*3)-2, 1), "quarter")
qdates <- c(qdates, qdate)
tab1 = append(tab1, list(data.frame(date=qdate, estimate=td1[2,2], conf.low=td1[2,5], conf.high=td1[2,6])))
tab2 = append(tab2, list(data.frame(date=qdate, estimate=td2[1,2], conf.low=td2[1,5], conf.high=td2[1,6])))
}
}
}
tab1 <- as.data.frame(do.call(rbind, tab1))
tab2 <- as.data.frame(do.call(rbind, tab2))
rownames(tab1) <- as.character(qdates)
rownames(tab2) <- as.character(qdates)
colnames(tab1) <- c("date", "estimate", "conf.low", "conf.high")
colnames(tab2) <- c("date", "estimate", "conf.low", "conf.high")
tab1 |>
ggplot(aes(x = date)) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), fill = "#E69F00", alpha = 0.15) +
geom_line(aes(y = conf.low), color = "#D55E00", linetype = "dashed", linewidth = 0.5) +
geom_line(aes(y = conf.high), color = "#D55E00", linetype = "dashed", linewidth = 0.5) +
geom_line(aes(y = estimate), color = "#222222", linewidth = 1) +
labs(
# title = "Your Main Project Title",
# subtitle = "Optional descriptive subtitle line",
x = "Time (in years)",
y = "Estimate of DPC coefficient (with 95% conf. Int)",
# caption = "Data Source: Internal Database"
) +
theme_minimal()
tab2 |>
ggplot(aes(x = date)) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), fill = "deepskyblue", alpha = 0.15) +
geom_line(aes(y = conf.low), color = "deepskyblue3", linetype = "dashed", linewidth = 0.5) +
geom_line(aes(y = conf.high), color = "deepskyblue3", linetype = "dashed", linewidth = 0.5) +
geom_line(aes(y = estimate), color = "navyblue", linewidth = 1) +
labs(
# title = "Your Main Project Title",
# subtitle = "Optional descriptive subtitle line",
x = "Time (in years)",
y = "Estimate of DPC coefficient (with 95% conf. Int)",
# caption = "Data Source: Internal Database"
) +
theme_minimal()
colnames(Transactions)
glt_base <-
data.table::CJ(
date = seq(
from = lubridate::floor_date(as.POSIXct("2019-01-01", tz="UTC"), unit = "day"),
to = lubridate::floor_date(as.POSIXct("2024-12-31", tz="UTC"), unit = "day"),
by = "day"
)
) |>
mutate(
interval_start = floor_date(date - ddays(30), unit = "day"),
interval_end = date
) |>
left_join(
Transactions |>
filter(asset_contract == LandContract, lubridate::year(date) %in% 2019:2024) |>
filter(type == "transfer" & is_sale == T & sale_related_market == "dcl-marketplace-1") |>
select(sale_date = date, amount_usd),
by = join_by(interval_start <= sale_date, interval_end > sale_date)
) |>
summarise(
vol_med = median(amount_usd),
vol_tot = sum(amount_usd),
vol_N = sum(!is.na(amount_usd)),
.by = "date"
) |>
mutate(
vol_med = replace_na(vol_med, 0L),
vol_tot = replace_na(vol_tot, 0L),
vol_N = replace_na(vol_N, 0L)
)
View(glt_base)
min(Transactions$date)
x = Transactions |>
filter(asset_contract == LandContract, lubridate::year(date) %in% 2019:2024) |>
filter(type == "transfer" & is_sale == T & sale_related_market == "dcl-marketplace-1") |>
select(sale_date = date, amount_usd)
min(x$sale_date)
