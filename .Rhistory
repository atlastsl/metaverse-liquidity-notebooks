spreads <- Transactions |>
filter(asset_contract == LandContract, type == "order", order_type == "ask", order_market == "dcl-marketplace-1") |>
select(asset_id, date, taker, amount, amount_usd, order_time_on_market, order_status, order_canceled_by) |>
transmute(
asset_id,
ask_date = date,
asker = taker,
ask_price = amount,
ask_price_usd = amount_usd,
tom = order_time_on_market,
status = order_status,
canceled_by = order_canceled_by
) |>
distinct(asset_id, ask_date, .keep_all = T) |>
left_join(
listings |> select(asset_id, list_start, list_end, list_price = price_raw),
by = join_by(asset_id, ask_date >= list_start, ask_date < list_end)
) |>
group_by(asset_id, ask_date) |>
filter(n() == 1) |>
ungroup() |>
filter(!is.na(list_start)) |>
# group_by(asset_id, list_start, taker) |>
# mutate(
#   nnn = n(),
# ) |>
# summarise(
#   list_end = first(list_end),
#   list_price = first(list_price),
#   ask_price = max(ask_price),
#   ask_price_usd = ask_price_usd[which.max(ask_price)],
#   .groups = "drop"
# ) |>
mutate(
spread = list_price - ask_price,
spread_ss = spread * (ask_price_usd / ask_price),
spread_rt = (list_price / ask_price),
ctom = time_length(ask_date - list_start, unit = "second")/86400
)
spreads <- locations_merger(spreads)
saveRDS(spreads, file = "spreads_db.RDS")
quantile(spreads$spread_rt, probs = c(0.01, 0.99))
quantile(spreads$spread_rt, probs = c(0.00, 0.99))
min(spreads$spread_rt)
#| label: tbl-h10-v2-res-3
#| tbl-cap: "Lien Liquidité Demande - Localisation & Paramètres de renégociation<br> La liquidité de demande est mesurée par le taux d'acceptation de la renégociation, tandis que les paramètres de renégociation sont le temps déjà passé sur le marché et le spread de renégociation. Ce dernier est calculé par le ratio des prix cryptos (Prix Listing / Prix Sollicitation), et les régressions sont faites pour chaque régime de marché."
#| warning: false
#| echo: false
library(lubridate)
library(dplyr)
library(tidyr)
library(modelsummary)
library(broom)
library(tinytable)
library(DescTools)
library(ggplot2)
#######################################
## Regressions
#######################################
source("./models.R")
my_gof <- list(
list("raw" = "q.controls",     "clean" = "FE Quarters", fmt = 0),
list("raw" = "loc.controls",     "clean" = "Loc Controls", fmt = 0),
list("raw" = "nobs",     "clean" = "Num.Obs.",    "fmt" = 0),
list("raw" = "r2.nagelkerke", "clean" = "R2 Nagel.", "fmt" = 3),
list("raw" = "concordance",   "clean" = "Concordance",    "fmt" = 2),
list("raw" = "concordance.std",   "clean" = "Concordance Std",    "fmt" = 3),
list("raw" = "aic",      "clean" = "AIC",         "fmt" = 1),
list("raw" = "bic",      "clean" = "BIC",         "fmt" = 1),
list("raw" = "rmse",     "clean" = "RMSE",        "fmt" = 2)
)
spreads_db <- readRDS(file = "spreads_db.RDS")
spreads_db <- spreads_db |>
#filter(if_all(c("spread_rt"), ~ filter_outliers(.x))) |>
#mutate(Spread = spread_rt) |>
mutate(cTom = log1p(ctom)) |>
filter(!is.na(tom) & tom > 0) |>
mutate(
Sold = as.numeric(status == "filled" & tom <= 365),
Tom = if_else(tom > 365, 365, tom),
Spread = log(Winsorize(spread_rt, val = quantile(spread_rt, probs = c(0.00, 0.99))))
) |>
mutate(quarter = quarter(ask_date), year = year(ask_date)) |>
Xcols <- c("DPC", "CPX", "CRD", "CDX", "North", "cTom", "Spread")
